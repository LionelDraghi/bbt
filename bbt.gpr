with "src/Alire_config/bbt_config.gpr";

project BBT is

   --  The Status_Bar.Platform body is platform dependent: the bodies
   --  are selected per host OS, only one of the two dirs below is used.
   --  Same for the GUI backends: AT-SPI is only available on Linux;
   --  Windows and macOS use the no_gui backend, whose bodies are
   --  clean "unsupported" errors, per the GUI vocabulary proposal.
   case Bbt_Config.Alire_Host_OS is
      when "windows" =>
         for Source_Dirs use ("src", "src/Alire_config", "src/windows",
                              "src/no_gui");
      when "linux" =>
         for Source_Dirs use ("src", "src/Alire_config", "src/posix",
                              "src/atspi");
      when others =>
         for Source_Dirs use ("src", "src/Alire_config", "src/posix",
                              "src/no_gui");
   end case;

   --  src/posix holds the C wrapper on ioctl(TIOCSWINSZ), only compiled
   --  on the platforms with pseudo terminal support: the C sources are
   --  then only in the non Windows source dirs
   for Languages use ("Ada", "C");

   for Object_Dir use "obj/" & Bbt_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "./";
   for Main use ("bbt-main.adb");

   package Compiler is
      --  Per-profile objectives:
      --  - development: iterate fast towards the executable, no
      --    runtime assertions, static checks still enforced
      --  - validation: find errors - all checks embedded, no
      --    time-costly optimization
      --  - release: deliver an optimized executable, no check and
      --    no style enforcement
      --
      --  -gnatX0 is the level 0 GNAT extension set, required by the
      --  External_Initialization aspect (bbt-cmd_line-put_help.adb)
      --
      --  Style check letters (-gnaty...), per GNAT 16:
      --  a attribute casing, b no blanks at end of lines, e end/exit
      --  labels, f no form feeds, h no tabs, i if-then layout, k
      --  keyword casing, l layout, n Standard casing, p pragma
      --  casing, r references casing, t token spacing, x no extra
      --  parentheses

      --  Common to all profiles (cf. comments above): -gnatX0 is
      --  required by every profile, it compiles
      --  bbt-cmd_line-put_help.adb.
      Common_Switches :=
        ("-gnat2022",   --  Ada 2022 mode
         "-g",          --  debug info
         "-gnatX0",     --  level 0 extensions (External_Initialization)
         "-gnatf",      --  full errors, verbose details
         "-gnatwa");    --  most optional warnings

      --  Profile-specific additions, on top of Common_Switches:
      case Bbt_Config.Build_Profile is

         when "development" =>
            for Switches ("ada") use
              Common_Switches &
              ("-O0",                    --  no optimization, fast compile
               "-gnatQ",                 --  don't quit, emit ali on errors
               "-gnatyabefhiklnprtx");   --  style checks, cf. legend

         when "validation" =>
            for Switches ("ada") use
              Common_Switches &
              ("-gnatyabefhiklnprtx",    --  style checks, cf. legend
               "-gnato",                 --  overflow checks, strict mode
               "-fstack-check",          --  stack overflow checks
               "-gnata",                 --  assertions and contracts enabled
               "-gnateE",                --  extra infos in exception messages
               "-gnatVa");               --  all validity checks

         when "release" =>
            for Switches ("ada") use
              Common_Switches &
              ("-O3",                    --  full optimization
               "-gnatn");                --  cross-unit inlining
      end case;
   end Compiler;

   package Binder is
      for Switches ("ada") use ("-Es", "-E");
   end Binder;

   package Builder is
      for Executable ("bbt-main.adb") use "bbt";
      for Default_Switches ("ada") use ("-j2");
   end Builder;

   package Linker is
      case Bbt_Config.Alire_Host_OS is
         when "linux" =>
            for Switches ("ada") use ("-g", "-l:libatspi.so.0",
                                      "-lgobject-2.0", "-lglib-2.0");
         when others =>
            for Switches ("ada") use ("-g");
      end case;
   end Linker;

   package Pretty_Printer is
      for Default_Switches ("ada") use ("-A0", "-M80", "-W8", "--no-separate-loop-then", "-l2", "-c2", "-A1", "-A2", "-A4", "-A5", "-A3");
   end Pretty_Printer;

   package Coverage is
         for Switches ("*") use ("--level=stmt");
   end Coverage;

end BBT;

