with "../../src/Alire_config/bbt_config.gpr";

project BBT_Backends is

   --  The shared backend support library crate: polling, harness
   --  deadline, text normalization, and failure diagnostics helpers
   --  common to every GUI backend, owned by no GUI stack
   --  (cf. docs/dev/design_discussions.md (D16)). Like bbt_lib, built
   --  locally with gprbuild against the sibling core sources; the
   --  alr manifests target publication.

   for Source_Dirs use ("src");

   for Object_Dir use "obj/" & Bbt_Config.Build_Profile;
   for Create_Missing_Dirs use "True";

   for Library_Name use "bbt_backends";
   for Library_Dir use "lib/" & Bbt_Config.Build_Profile;
   for Library_Kind use "static";

   package Compiler is
      --  Same per-profile switch policy as bbt_lib.gpr (kept in sync:
      --  the backend crates are built and validated with the same
      --  profiles as the core).
      Common_Switches :=
        ("-gnat2022",   --  Ada 2022 mode
         "-g",          --  debug info
         "-gnatf",      --  full errors, verbose details
         "-gnatwa");    --  most optional warnings

      case Bbt_Config.Build_Profile is

         when "development" =>
            for Switches ("ada") use
              Common_Switches &
              ("-O0",
               "-gnatQ",
               "-gnatyabefhiklnprtx");

         when "validation" =>
            for Switches ("ada") use
              Common_Switches &
              ("-gnatyabefhiklnprtx",
               "-gnato",
               "-fstack-check",
               "-gnata",
               "-gnateE",
               "-gnatVa");

         when "release" =>
            for Switches ("ada") use
              Common_Switches &
              ("-O3",
               "-gnatn");
      end case;
   end Compiler;

end BBT_Backends;
