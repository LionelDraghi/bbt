with "../../bbt_lib.gpr";
with "../../backends/common/bbt_backends.gpr";

with "../../src/Alire_config/bbt_config.gpr";

project BBT_Webapp is

   --  The web backend crate: the bbt_webapp executable, which registers
   --  the WebDriver backend and runs the bbt driver on top of the
   --  BBT_Lib archive (cf. docs/dev/design_discussions.md (D16)). The
   --  bbt core CLI delegates to this executable with --backend=webapp.

   for Source_Dirs use ("src");
   for Exec_Dir use "./";
   for Main use ("bbt_webapp-main.adb");
   for Object_Dir use "obj";
   for Create_Missing_Dirs use "True";

   package Builder is
      for Executable ("bbt_webapp-main.adb") use "bbt_webapp";
      for Default_Switches ("ada") use ("-j2");
   end Builder;

   package Compiler is
      --  Same per-profile switch policy as bbt_lib.gpr (kept in sync:
      --  the backend executables are built and validated with the
      --  same profiles as the core).
      Common_Switches :=
        ("-gnat2022",
         "-g",
         "-gnatX0",
         "-gnatf",
         "-gnatwa");

      case Bbt_Config.Build_Profile is

         when "development" =>
            for Switches ("ada") use
              Common_Switches &
              ("-O0",
               "-gnatQ",
               "-gnatyabefhiklnprtx");

         when "validation" =>
            for Switches ("ada") use
              Common_Switches &
              ("-gnatyabefhiklnprtx",
               "-gnato",
               "-fstack-check",
               "-gnata",
               "-gnateE",
               "-gnatVa");

         when "release" =>
            for Switches ("ada") use
              Common_Switches &
              ("-O3",
               "-gnatn");
      end case;
   end Compiler;

   package Binder is
      for Switches ("ada") use ("-Es", "-E");
   end Binder;

end BBT_Webapp;
