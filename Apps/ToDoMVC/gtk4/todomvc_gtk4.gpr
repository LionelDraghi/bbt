with "gtkada.gpr";

project TodoMvc_Gtk4 is

   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Exec_Dir use ".";
   for Main use ("todomvc");

   package Compiler is
      for Switches ("ada") use ("-gnat2022", "-gnatwa");
   end Compiler;

end TodoMvc_Gtk4;
